{
  "openapi": "3.1.0",
  "info": {
    "title": "Bench Atlas 只读接口",
    "version": "v1",
    "description": "从校园内网或本机读取已发布快照，无需令牌。数据响应携带快照版本，题号和模型标识均为字符串。"
  },
  "servers": [{"url": "/"}],
  "security": [],
  "paths": {
    "/api/v1": {
      "get": {
        "operationId": "discover",
        "summary": "发现 v1 接口",
        "responses": {
          "200": {"description": "服务入口与版本", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Discovery"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "405": {"$ref": "#/components/responses/MethodNotAllowed"}
        }
      }
    },
    "/api/v1/datasets": {
      "get": {
        "operationId": "listDatasets",
        "summary": "列出快照内的数据集",
        "responses": {
          "200": {"description": "数据集目录", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Catalog"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "405": {"$ref": "#/components/responses/MethodNotAllowed"}
        }
      }
    },
    "/api/v1/dataset": {
      "get": {
        "operationId": "getDataset",
        "summary": "查看一个数据集及其来源",
        "parameters": [{"$ref": "#/components/parameters/DatasetId"}],
        "responses": {
          "200": {"description": "数据集元数据", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DatasetResponse"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "405": {"$ref": "#/components/responses/MethodNotAllowed"}
        }
      }
    },
    "/api/v1/questions": {
      "get": {
        "operationId": "listQuestions",
        "summary": "按数据集检索并分页读取题目摘要",
        "parameters": [
          {"$ref": "#/components/parameters/DatasetId"},
          {"name": "q", "in": "query", "description": "可选检索词。省略时列出全部题目。", "schema": {"type": "string"}},
          {"name": "limit", "in": "query", "description": "每页最多返回的题数。", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 30}},
          {"name": "offset", "in": "query", "description": "跳过的匹配题数，从 0 开始。", "schema": {"type": "integer", "minimum": 0, "default": 0}}
        ],
        "responses": {
          "200": {"description": "题目摘要与本次查询的分页信息", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/QuestionPage"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "405": {"$ref": "#/components/responses/MethodNotAllowed"}
        }
      }
    },
    "/api/v1/question": {
      "get": {
        "operationId": "getQuestion",
        "summary": "读取题面、作者参考及归档答卷",
        "parameters": [
          {"$ref": "#/components/parameters/DatasetId"},
          {"name": "qid", "in": "query", "required": true, "description": "来自题目摘要的原始字符串编号。", "schema": {"type": "string", "minLength": 1}},
          {"$ref": "#/components/parameters/ModelId"}
        ],
        "responses": {
          "200": {"description": "单题材料及所选模型的逐题记录", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/QuestionResponse"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "405": {"$ref": "#/components/responses/MethodNotAllowed"}
        }
      }
    },
    "/api/v1/scores": {
      "get": {
        "operationId": "listScores",
        "summary": "读取数据集内的模型汇总成绩",
        "parameters": [{"$ref": "#/components/parameters/DatasetId"}, {"$ref": "#/components/parameters/ModelId"}],
        "responses": {
          "200": {"description": "模型汇总行及其归档版本", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ScoresResponse"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "405": {"$ref": "#/components/responses/MethodNotAllowed"}
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "operationId": "getOpenApi",
        "summary": "取得此 OpenAPI 3.1 文档",
        "responses": {
          "200": {"description": "独立的 OpenAPI 契约，顶层为 OpenAPI 文档对象。", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OpenApiDocument"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "405": {"$ref": "#/components/responses/MethodNotAllowed"}
        }
      }
    }
  },
  "components": {
    "parameters": {
      "DatasetId": {"name": "dataset", "in": "query", "required": true, "description": "数据集目录中的 id。", "schema": {"type": "string", "minLength": 1}},
      "ModelId": {"name": "model", "in": "query", "description": "该数据集内的 model_id。省略时返回该数据集的全部模型。", "schema": {"type": "string", "minLength": 1}}
    },
    "responses": {
      "BadRequest": {"description": "参数缺失或无效。", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "NotFound": {"description": "指定的资源不存在。", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "MethodNotAllowed": {"description": "不支持该请求方法。使用 GET 读取资源。", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
    },
    "schemas": {
      "Error": {
        "type": "object", "required": ["error"],
        "properties": {"error": {"type": "string"}}
      },
      "Envelope": {
        "type": "object", "required": ["api_version", "snapshot_version"],
        "properties": {
          "api_version": {"type": "string", "const": "v1"},
          "snapshot_version": {"type": "string", "description": "已发布数据快照的版本。"}
        }
      },
      "Discovery": {
        "allOf": [
          {"$ref": "#/components/schemas/Envelope"},
          {"type": "object", "required": ["links"], "properties": {"links": {"type": "object", "additionalProperties": {"type": "string"}}}}
        ]
      },
      "Catalog": {
        "allOf": [
          {"$ref": "#/components/schemas/Envelope"},
          {"type": "object", "required": ["datasets"], "properties": {"datasets": {"type": "array", "items": {"$ref": "#/components/schemas/Dataset"}}}}
        ]
      },
      "DatasetResponse": {
        "allOf": [
          {"$ref": "#/components/schemas/Envelope"},
          {"type": "object", "required": ["dataset"], "properties": {"dataset": {"$ref": "#/components/schemas/Dataset"}}}
        ]
      },
      "Dataset": {
        "type": "object", "required": ["id", "name", "description", "metric", "question_count", "provenance"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "description": {"type": ["string", "null"]},
          "metric": {"type": ["string", "null"]},
          "question_count": {"type": "integer", "minimum": 0},
          "provenance": {"$ref": "#/components/schemas/Provenance"}
        }
      },
      "Provenance": {
        "type": ["object", "null"], "description": "各部分保留归档原文和原生字段。缺少来源文件时为 null。",
        "properties": {
          "upstream": {"type": ["object", "null"]},
          "split": {"type": ["object", "null"]},
          "scoring": {"type": ["object", "null"]},
          "run_batches": {"type": ["array", "null"], "items": {"type": "object"}},
          "rights": {"type": ["object", "null"]}
        }
      },
      "QuestionPage": {
        "allOf": [
          {"$ref": "#/components/schemas/Envelope"},
          {"type": "object", "required": ["items", "pagination"], "properties": {
            "items": {"type": "array", "items": {"$ref": "#/components/schemas/QuestionSummary"}},
            "pagination": {"$ref": "#/components/schemas/Pagination"}
          }}
        ]
      },
      "Pagination": {
        "type": "object", "required": ["limit", "offset", "total", "next_offset"],
        "properties": {
          "limit": {"type": "integer", "minimum": 1, "maximum": 100},
          "offset": {"type": "integer", "minimum": 0},
          "total": {"type": "integer", "minimum": 0, "description": "所有匹配题目数。"},
          "next_offset": {"type": ["integer", "null"], "minimum": 0, "description": "下一页偏移量，读到末页时为 null。"}
        }
      },
      "QuestionSummary": {
        "type": "object", "required": ["dataset_id", "qid", "title", "category"],
        "properties": {
          "dataset_id": {"type": "string"},
          "qid": {"type": "string"},
          "title": {"type": ["string", "null"]},
          "category": {"type": ["string", "null"]}
        }
      },
      "QuestionResponse": {
        "allOf": [
          {"$ref": "#/components/schemas/Envelope"},
          {"type": "object", "required": ["dataset", "question", "evaluations"], "properties": {
            "dataset": {"$ref": "#/components/schemas/Dataset"},
            "question": {"$ref": "#/components/schemas/Question"},
            "evaluations": {"type": "array", "items": {"$ref": "#/components/schemas/Evaluation"}}
          }}
        ]
      },
      "Question": {
        "allOf": [
          {"$ref": "#/components/schemas/QuestionSummary"},
          {"type": "object", "required": ["prompt", "reference_answer", "reference_solution", "review_criteria", "assets"], "properties": {
            "prompt": {"type": ["string", "null"]},
            "reference_answer": {"type": ["string", "null"]},
            "reference_solution": {"type": ["string", "null"]},
            "review_criteria": {"type": ["array", "null"], "items": {"type": "string"}, "description": "归档逐题评审核对项。没有逐项记录时为 null。"},
            "assets": {"type": "array", "items": {"type": "string", "format": "uri-reference"}, "description": "题图地址，可相对于服务源站解析。"}
          }}
        ]
      },
      "Evaluation": {
        "type": "object", "required": ["model_id", "record_status", "answer", "verdict", "basis", "version", "score"],
        "properties": {
          "model_id": {"type": "string"},
          "record_status": {"type": "string", "enum": ["recorded", "missing"], "description": "按是否存在归档答卷区分。"},
          "answer": {"type": ["string", "null"]},
          "reasoning": {"type": ["string", "null"], "description": "该答卷归档的模型推理文本。"},
          "verdict": {"type": ["string", "null"]},
          "basis": {"type": ["string", "null"]},
          "version": {"type": ["string", "null"], "description": "逐题记录的归档批次。"},
          "score": {"$ref": "#/components/schemas/ItemScore"}
        }
      },
      "ItemScore": {
        "type": "object", "required": ["raw", "value", "metrics"],
        "properties": {
          "raw": {"type": ["string", "null"], "description": "归档的逐题分数原文。"},
          "value": {"type": ["number", "null"], "description": "单一数值分，可为 0。缺少单一数值时为 null。"},
          "metrics": {
            "type": "object", "description": "有归档依据的分项指标，无可用分项时为空对象。",
            "properties": {
              "entity_span_f1": {"type": "number", "description": "PolyIE 严格实体跨度 F1。"},
              "relation_tuple_f1": {"type": "number", "description": "PolyIE 严格关系元组 F1。"}
            }
          }
        }
      },
      "ScoresResponse": {
        "allOf": [
          {"$ref": "#/components/schemas/Envelope"},
          {"type": "object", "required": ["scores"], "properties": {"scores": {"type": "array", "items": {"$ref": "#/components/schemas/AggregateScore"}}}}
        ]
      },
      "AggregateScore": {
        "type": "object", "required": ["dataset_id", "model_id", "primary", "secondary", "sort_value", "version"],
        "properties": {
          "dataset_id": {"type": "string"},
          "model_id": {"type": "string"},
          "primary": {"type": ["string", "null"], "description": "主指标的展示文本。"},
          "secondary": {"type": ["string", "null"], "description": "补充指标或计数的展示文本。"},
          "sort_value": {"type": ["number", "null"], "description": "本数据集的汇总排序值。"},
          "version": {"type": "string", "description": "模型汇总记录的归档批次。"}
        }
      },
      "OpenApiDocument": {
        "type": "object", "required": ["openapi", "info", "paths"],
        "properties": {"openapi": {"type": "string", "const": "3.1.0"}, "info": {"type": "object"}, "paths": {"type": "object"}}
      }
    }
  }
}
